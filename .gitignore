# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# 项目级配置 dotdir（镜像 ~/.ainovel/）：config.json 含密钥，rules/ 为本地写作偏好
.ainovel/

# Editor/IDE/OS
.idea/
.vscode/
.cache
.DS_Store
Thumbs.db

# GoReleaser artifacts
dist/
release-notes.md
/ainovel-cli

tasks
refer/
# Thư mục truyện của bản CLI cũ (output/, output-webfix/…) — dữ liệu cá nhân, không thuộc repo.
output*
workspace/

# Đầu ra build của app (desktop/.gitignore cũng chặn; ghi lại ở gốc cho rõ):
# desktop/resources/{bin,web,legal} do build-sidecar.sh + gen-legal.sh sinh mỗi lần build.
desktop/out/
desktop/resources/

# công cụ i18n
scripts/i18n/__pycache__/

# Worktree cô lập cho việc thi hành kế hoạch (superpowers:using-git-worktrees).
# Phải bị ignore, nếu không nội dung worktree lọt vào chính repo.
.worktrees/

# Trạng thái công cụ oh-my-claudecode (ảnh chụp, log, state) — không thuộc sản phẩm.
.omc/

# Ảnh chụp và nhật ký phiên làm việc của skill thiết kế (impeccable).
# `brief-v2.md` và `design.json` là bối cảnh thiết kế BỀN, có theo dõi; ba thư mục
# dưới đây là vật phẩm của từng phiên — 25MB ảnh chụp màn hình và một tệp trạng
# thái mang PID/cổng của máy đang chạy, không có nghĩa trên máy khác.
.impeccable/review/
.impeccable/questions/
.impeccable/mocks/
